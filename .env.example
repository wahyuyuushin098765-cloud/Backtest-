# ============================================================
#  Backtest EMA-Cross Reversal + Flip Protection — Environment Variables
#  Copy file ini jadi .env untuk run lokal,
#  atau isi langsung di Railway → Variables
# ============================================================

# ---- Parameter backtest (semua opsional, sudah ada default) ----

# Modal awal — SATU AKUN BERSAMA untuk semua koin (bukan per-coin). Default: 30
INITIAL_BALANCE=30.0

# Risk per trade = persen dari balance TERKINI (compounding, 1 balance bersama). Default: 0.01 = 1%
RISK_PCT=0.01

# Jumlah slot maksimum (posisi aktif + limit terpasang) GLOBAL, dipakai bersama
# oleh SEMUA koin sekaligus (persis seperti bot live). Kalau penuh, sinyal valid
# baru dari koin lain akan dilewati (terhitung di "Blokir: Slot" pada dashboard).
# Default: TANPA BATAS (kosongkan / isi 0 / 'unlimited'). Isi angka (mis. 10) utk membatasi.
MAX_CONCURRENT=0

# PORTFOLIO RISK CAP: batas TOTAL $ risiko dari SEMUA posisi terbuka bersamaan
# (estimasi rugi kalau SEMUA kena SL sekaligus), sbg persentase dari balance.
# Ini yg mencegah compounding meledak tak terkendali saat MAX_CONCURRENT tanpa batas
# (banyak posisi paralel, masing2 1% balance yg sama & terus tumbuh, bisa jadi puluhan%
# risiko sesaat kalau tak dibatasi). Independen dari MAX_CONCURRENT. Default: 0.20 = 20%
MAX_PORTFOLIO_RISK_PCT=0.20

# FILTER OPSIONAL berbasis indikator saat cross (lihat tabel "Analisis Indikator saat
# Cross" di dashboard utk cari nilai ambang yg pas). Default semua 0 = nonaktif.
FILTER_MIN_ATR_RATIO=0
FILTER_MIN_VOL_RATIO=0
FILTER_MAX_EMA_GAP_PCT=0

# Periode indikator tambahan (utk analisis pola menang/kalah saat cross)
VOL_MA_PERIOD=20
ATR_PERIOD=14
EMA_TREND=50

# Hedge mode: true = Long & Short boleh jalan bareng per koin. Default: true
ALLOW_HEDGE=true

# Taker fee per sisi (Bybit USDT perp). Default: 0.00055 (0.055%)
FEE_PCT=0.00055

# Rentang histori H1 yang di-backtest, dalam hari ke belakang. Default: 300
BACKTEST_DAYS=300

# Periode EMA cepat & lambat (H1). Default: 4 dan 10
EMA_FAST=4
EMA_SLOW=10

# Rasio aktivasi trailing stop (1:N dari jarak entry-SL). Default hasil riset terbaik: 6
TRAIL_ACT_R=6.0

# Lebar trailing stop = TRAIL_STOP x jarak(entry,SL). Default: 1.0
TRAIL_STOP=1.0

# Floor keamanan SL minimum (persen dari entry). Default: 0.002 = 0.2%
MIN_DIST_PCT=0.002

# Port log server (Railway otomatis set ini, tidak perlu diubah)
# PORT=8080

# ============================================================
#  Bot LIVE TRADING (bot_ema_flip.py) — kalau mau dideploy TERPISAH
#  sebagai service lain di Railway. Backtest (backtest_web.py) TIDAK
#  butuh API_KEY/API_SECRET karena cuma baca data publik Bybit.
# ============================================================
# API_KEY=isi_api_key_kamu_di_sini
# API_SECRET=isi_api_secret_kamu_di_sini
# TESTNET=false
# ALLOW_HEDGE=true
# MAX_CONCURRENT=10
# LEVERAGE=25

