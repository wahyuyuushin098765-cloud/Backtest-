# ============================================================
#  Backtest EMA-Cross Reversal + Flip Protection — Environment Variables
#  Copy file ini jadi .env untuk run lokal,
#  atau isi langsung di Railway → Variables
# ============================================================

# ---- Rentang backtest: FIX (bukan "N hari terakhir") supaya data bisa di-cache ----
BACKTEST_START_DATE=2025-08-01
BACKTEST_END_DATE=2026-07-31

# ---- Parameter backtest (semua opsional, sudah ada default) ----

# Modal awal — SATU AKUN BERSAMA untuk semua koin (bukan per-coin). Default: 30
INITIAL_BALANCE=30.0

# Risk per trade = persen dari balance TERKINI (compounding, 1 balance bersama). Default: 0.01 = 1%
RISK_PCT=0.01

# LEVERAGE & MARGIN — constraint PALING REALISTIS dari exchange asli. Risk 1% tidak
# berarti "99 kesempatan lagi", karena tiap posisi tetap butuh margin (notional/leverage),
# dan begitu margin gabungan semua posisi terbuka mentok, order baru otomatis ditolak
# (persis kalau margin habis di Bybit beneran) -- ini constraint yg jauh lebih dominan
# drpd sekadar batas jumlah slot.
LEVERAGE=25
MARGIN_USAGE_CAP=0.90

# Jumlah slot maksimum (posisi aktif + limit terpasang) GLOBAL, dipakai bersama
# oleh SEMUA koin sekaligus (persis seperti bot live). Kalau penuh, sinyal valid
# baru dari koin lain akan dilewati (terhitung di "Blokir: Slot" pada dashboard).
# Default: TANPA BATAS (kosongkan / isi 0 / 'unlimited'). Isi angka (mis. 10) utk membatasi.
# Dengan MARGIN di atas, batas alami tetap muncul walau ini dibiarkan tanpa batas.
MAX_CONCURRENT=0

# Hedge mode: true = Long & Short boleh jalan bareng per koin. Default: true
ALLOW_HEDGE=true

# Taker fee per sisi (Bybit USDT perp). Default: 0.00055 (0.055%)
FEE_PCT=0.00055

# Periode EMA cepat & lambat (H1). Default: 4 dan 10
EMA_FAST=4
EMA_SLOW=10

# Rasio aktivasi trailing stop (1:N dari jarak entry-SL). Default hasil riset terbaik: 6
TRAIL_ACT_R=6.0

# Lebar trailing stop = TRAIL_STOP x jarak(entry,SL). Default: 1.0
TRAIL_STOP=1.0

# Floor keamanan SL minimum (persen dari entry). Default: 0.002 = 0.2%
MIN_DIST_PCT=0.002

# FILTER berbasis indikator saat cross. DEFAULT AKTIF: ATR ratio >= 1.07 (candle penyebab
# cross harus lebih besar dari volatilitas normalnya) -- dari hasil analisis, ini indikator
# dgn spread win-rate paling konsisten & kuat. Tiap indikator punya MIN dan MAX (0 = sisi
# itu nonaktif) supaya bisa bikin filter "range" (bukan cuma satu arah), karena hasil riset
# menunjukkan pola bucket Rendah/Sedang/Tinggi TIDAK selalu monoton (bisa ada sweet spot
# di tengah). Isi 0 utk mematikan / ganti sesuai temuan analisis terbarumu di dashboard.
FILTER_MIN_ATR_RATIO=1.07
FILTER_MAX_ATR_RATIO=0
FILTER_MIN_VOL_RATIO=0
FILTER_MAX_VOL_RATIO=0
FILTER_MIN_EMA_GAP_PCT=0
FILTER_MAX_EMA_GAP_PCT=0
FILTER_MIN_DIST_PCT=0
FILTER_MAX_DIST_PCT=0

# Periode indikator tambahan (utk analisis pola menang/kalah saat cross)
VOL_MA_PERIOD=20
ATR_PERIOD=14
EMA_TREND=50

# ---- Cache data candle H1 (supaya TIDAK fetch ulang dari Bybit tiap kali variable diubah) ----
# Arahkan ke mount point Railway Volume (mis. /data/cache) supaya persisten lintas redeploy.
# Tanpa Volume, cache tetap jalan tapi hilang tiap redeploy container.
CACHE_DIR=./data_cache

# Port log server (Railway otomatis set ini, tidak perlu diubah)
# PORT=8080

# ============================================================
#  Bot LIVE TRADING (bot_ema_flip.py) — kalau mau dideploy TERPISAH
#  sebagai service lain di Railway. Backtest (backtest_web.py) TIDAK
#  butuh API_KEY/API_SECRET karena cuma baca data publik Bybit.
# ============================================================
# API_KEY=isi_api_key_kamu_di_sini
# API_SECRET=isi_api_secret_kamu_di_sini
# TESTNET=false
# ALLOW_HEDGE=true
# MAX_CONCURRENT=10
# LEVERAGE=25
# Filter ATR jg sudah aktif di bot live (default sama: FILTER_MIN_ATR_RATIO=1.07).
# FILTER_MIN_ATR_RATIO=1.07
# FILTER_MAX_ATR_RATIO=0
# ATR_PERIOD=14
