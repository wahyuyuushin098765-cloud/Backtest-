# ============================================================
#  Backtest EMA-Cross Reversal + Flip Protection — Environment Variables
#  Copy file ini jadi .env untuk run lokal,
#  atau isi langsung di Railway → Variables
# ============================================================

# ---- Parameter backtest (semua opsional, sudah ada default) ----

# Modal awal PER COIN (bukan gabungan). Default: 30
INITIAL_BALANCE=30.0

# Risk per trade (persen equity per coin, compounding). Default: 0.01 = 1%
RISK_PCT=0.01

# Taker fee per sisi (Bybit USDT perp). Default: 0.00055 (0.055%)
FEE_PCT=0.00055

# Rentang histori H1 yang di-backtest, dalam hari ke belakang. Default: 300
BACKTEST_DAYS=300

# Periode EMA cepat & lambat (H1). Default: 4 dan 10
EMA_FAST=4
EMA_SLOW=10

# Rasio aktivasi trailing stop (1:N dari jarak entry-SL). Default hasil riset terbaik: 6
TRAIL_ACT_R=6.0

# Lebar trailing stop = TRAIL_STOP x jarak(entry,SL). Default: 1.0
TRAIL_STOP=1.0

# Floor keamanan SL minimum (persen dari entry). Default: 0.002 = 0.2%
MIN_DIST_PCT=0.002

# Port log server (Railway otomatis set ini, tidak perlu diubah)
# PORT=8080

# ============================================================
#  Bot LIVE TRADING (bot_ema_flip.py) — kalau mau dideploy TERPISAH
#  sebagai service lain di Railway. Backtest (backtest_web.py) TIDAK
#  butuh API_KEY/API_SECRET karena cuma baca data publik Bybit.
# ============================================================
# API_KEY=isi_api_key_kamu_di_sini
# API_SECRET=isi_api_secret_kamu_di_sini
# TESTNET=false
# ALLOW_HEDGE=true
# MAX_CONCURRENT=10
# LEVERAGE=25

